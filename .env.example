# Copy this file to .env and fill in at least one key.
# With no key at all the app still runs on the offline mock LLM.

# --- Groq (free key: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_EXTRA_MODEL=qwen/qwen3.8-27b

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite

# --- Optional local model (install Ollama, then: ollama pull llama3.1) ---
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1

# Last-resort offline fallback so a demo never hard-fails
MOCK_FALLBACK=true

# --- Which models each agent uses (aliases: groq-large = GROQ_MODEL,
#     groq-small = GROQ_FALLBACK_MODEL, groq-extra, gemini, gemini-lite, gemini-backup).
#     Every configured model not listed is still used as an automatic fallback. ---
PLANNER_MODELS=groq-large,gemini
WRITER_MODELS=gemini-lite,groq-small
REVIEWER_MODELS=groq-large,gemini

# --- Agent behaviour ---
QUALITY_THRESHOLD=8
MAX_REVISION_ROUNDS=2
MAX_PARALLEL_WRITERS=2
